generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id           Int             @id @default(autoincrement())
  name         String
  slug         String          @unique
  stores       Store[]
  storeRoles   UserStoreRole[]
  auditLogs    AuditLog[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Store {
  id             Int             @id @default(autoincrement())
  organization_id Int
  name           String
  slug           String
  code           String          @unique
  gstin          String?
  address        String?
  default_gst_percentage Float   @default(5)
  auto_print_receipt Boolean     @default(true)
  include_gst_breakdown_on_receipt Boolean @default(true)
  enable_pos_dark_mode Boolean   @default(false)
  organization   Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  products       Product[]
  sales          Sales[]
  suppliers      Supplier[]
  purchases      PurchaseOrder[]
  customers      Customer[]
  storeRoles     UserStoreRole[]
  auditLogs      AuditLog[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organization_id, slug])
}

model UserStoreRole {
  id               Int           @id @default(autoincrement())
  user_id          Int
  organization_id  Int
  store_id         Int
  role             String
  active           Boolean       @default(true)
  user             User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization     Organization  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  store            Store         @relation(fields: [store_id], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([user_id, store_id])
  @@index([store_id, active])
}

model Product {
  id             Int        @id @default(autoincrement())
  store_id       Int
  name           String
  barcode        String
  price          Float
  gst_percentage Float
  stock          Int        @default(0)
  store          Store      @relation(fields: [store_id], references: [id], onDelete: Cascade)
  saleItems      SaleItem[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([store_id, barcode])
  @@index([store_id, name])
}

model Sales {
  id             Int        @id @default(autoincrement())
  store_id       Int
  bill_number    String
  total_amount   Float
  payment_method String
  customer_id    Int?
  store          Store      @relation(fields: [store_id], references: [id], onDelete: Cascade)
  customer       Customer?  @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  date           DateTime   @default(now())
  saleItems      SaleItem[]

  @@unique([store_id, bill_number])
  @@index([store_id, date])
}

model SaleItem {
  id         Int      @id @default(autoincrement())
  sale_id    Int
  product_id Int
  quantity   Int
  price      Float
  sale       Sales    @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Restrict)
}

model User {
  id          Int             @id @default(autoincrement())
  name        String
  username    String          @unique
  role        String
  password    String
  status      String          @default("Active")
  lastLogin   DateTime?
  storeRoles  UserStoreRole[]
  auditLogs   AuditLog[]
  createdAt   DateTime        @default(now())
}

model AuditLog {
  id               Int           @id @default(autoincrement())
  organization_id  Int
  store_id         Int?
  actor_user_id    Int?
  action           String
  entity_type      String
  entity_id        String?
  metadata         Json?
  organization     Organization  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  store            Store?        @relation(fields: [store_id], references: [id], onDelete: SetNull)
  actor            User?         @relation(fields: [actor_user_id], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())

  @@index([organization_id, createdAt])
  @@index([store_id, createdAt])
  @@index([actor_user_id, createdAt])
}

model Supplier {
  id          Int             @id @default(autoincrement())
  store_id    Int
  name        String
  contact     String
  phone       String
  email       String
  category    String
  active      Boolean         @default(true)
  store       Store           @relation(fields: [store_id], references: [id], onDelete: Cascade)
  purchases   PurchaseOrder[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([store_id, name])
}

model PurchaseOrder {
  id           Int       @id @default(autoincrement())
  store_id     Int
  po_number    String
  supplier_id  Int
  items_count  Int       @default(0)
  total_amount Float     @default(0)
  status       String    @default("Pending")
  date         DateTime  @default(now())
  store        Store     @relation(fields: [store_id], references: [id], onDelete: Cascade)
  supplier     Supplier  @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([store_id, po_number])
  @@index([store_id, createdAt])
}

model Customer {
  id           Int       @id @default(autoincrement())
  store_id     Int
  phone        String
  name         String?
  total_points Int       @default(0)
  store        Store     @relation(fields: [store_id], references: [id], onDelete: Cascade)
  purchases    Sales[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([store_id, phone])
  @@index([store_id, createdAt])
}

model ContactInquiry {
  id           Int      @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String
  organization String
  interest     String
  message      String?
  source       String   @default("website")
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model StudioProject {
  id           String   @id
  client       String
  name         String
  url          String
  passwordHash String
  status       String   @default("ACTIVE")
  latency      String   @default("4.5ms")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EmployeeUser {
  id         Int       @id @default(autoincrement())
  name       String
  email      String    @unique
  password   String
  role       String    @default("employee")
  department String    @default("General")
  departmentId Int?
  managerId Int?
  title      String    @default("Team Member")
  employeeType String  @default("Full-time")
  compensationStatus String @default("Paid")
  employmentStart DateTime?
  employmentEnd DateTime?
  workStartTime String @default("09:00")
  workEndTime String   @default("18:00")
  status     String    @default("Active")
  lastLogin  DateTime?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([role])
  @@index([status])
  @@index([departmentId])
  @@index([managerId])
  @@index([employeeType])
  @@index([compensationStatus])
  @@index([lastSeenAt])
}

model EmployeeCrmRecord {
  id          Int      @id @default(autoincrement())
  company     String
  contactName String
  email       String?
  phone       String?
  ownerRole   String   @default("sales")
  stage       String   @default("New")
  source      String   @default("Manual")
  priority    String   @default("Medium")
  leadRating  String   @default("Warm")
  estimatedValue Float @default(0)
  reminderAt  DateTime?
  nextAction  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerRole])
  @@index([stage])
  @@index([reminderAt])
  @@index([createdAt])
}

model EmployeeCrmSheet {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?
  sourceName      String?
  sourceType      String   @default("Pasted sheet")
  ownerRole       String   @default("sales")
  audienceRoles   String   @default("sales")
  status          String   @default("Pending")
  locked          Boolean  @default(true)
  columns         Json?
  requestedBy     Int?
  requestedByName String?
  approvedBy      Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  rows            EmployeeCrmSheetRow[]

  @@index([ownerRole])
  @@index([audienceRoles])
  @@index([status])
  @@index([requestedBy])
}

model EmployeeCrmSheetRow {
  id            Int      @id @default(autoincrement())
  sheetId       Int
  rowNumber     Int
  data          Json
  status        String   @default("Open")
  statusColor   String   @default("none")
  reason        String?
  notes         String?
  locked        Boolean  @default(false)
  updatedBy     Int?
  updatedByName String?
  doneAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sheet         EmployeeCrmSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@index([sheetId, rowNumber])
  @@index([status])
  @@index([updatedBy])
}

model EmployeeAttendance {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employeeName String
  workDate    DateTime
  loginAt     DateTime?
  logoutAt    DateTime?
  totalHours  Float     @default(0)
  status      String    @default("Present")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([employeeId])
  @@index([workDate])
  @@index([status])
}

model EmployeeLeaveRequest {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employeeName String
  leaveType   String   @default("Casual")
  startsAt    DateTime
  endsAt      DateTime
  status      String   @default("Pending")
  reason      String?
  reviewedBy  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([startsAt])
}

model EmployeeTask {
  id          Int      @id @default(autoincrement())
  title       String
  assignedTo  Int?
  assignedName String?
  ownerRole   String   @default("all")
  priority    String   @default("Medium")
  status      String   @default("Open")
  dueAt       DateTime?
  proofUrl    String?
  description String?
  createdBy   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([assignedTo])
  @@index([ownerRole])
  @@index([status])
  @@index([dueAt])
}

model EmployeePayrollInput {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employeeName String
  payPeriod   String
  payType     String   @default("Salary")
  amount      Float    @default(0)
  workingDays Float    @default(0)
  unpaidLeaveDays Float @default(0)
  bonus       Float    @default(0)
  deductions  Float    @default(0)
  status      String   @default("Draft")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([payPeriod])
  @@index([status])
}

model EmployeePerformanceReview {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employeeName String
  reviewPeriod String
  reviewerId  Int?
  score       Float    @default(0)
  kpiSummary  String?
  strengths   String?
  improvements String?
  status      String   @default("Draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([reviewPeriod])
  @@index([status])
}

model EmployeeDocument {
  id          Int      @id @default(autoincrement())
  employeeId  Int?
  employeeName String?
  title       String
  documentType String  @default("General")
  url         String
  fileName    String?
  fileSize    Int?
  mimeType    String?
  visibilityRoles String @default("super_admin,admin,hr")
  notes       String?
  uploadedBy  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([documentType])
  @@index([visibilityRoles])
}

model EmployeeDepartment {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  managerId   Int?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([managerId])
}

model EmployeeNotification {
  id          Int      @id @default(autoincrement())
  employeeId  Int?
  targetRoles String   @default("all")
  title       String
  body        String
  readAt      DateTime?
  createdBy   Int?
  createdAt   DateTime @default(now())

  @@index([employeeId])
  @@index([targetRoles])
  @@index([readAt])
}

model EmployeeExpenseClaim {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employeeName String
  category    String   @default("General")
  amount      Float    @default(0)
  claimDate   DateTime
  receiptUrl  String?
  status      String   @default("Pending")
  reviewerId  Int?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([claimDate])
}

model EmployeeAuditEvent {
  id          Int      @id @default(autoincrement())
  actorId     Int?
  actorName   String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model EmployeeAnnouncement {
  id          Int      @id @default(autoincrement())
  title       String
  body        String
  audienceRoles String @default("all")
  priority    String  @default("Normal")
  publishedBy Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([audienceRoles])
  @@index([priority])
  @@index([createdAt])
}

model EmployeeComment {
  id          Int      @id @default(autoincrement())
  entityType  String
  entityId    Int
  body        String
  authorId    Int?
  authorName  String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([authorId])
}

model EmployeeApplicant {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  phone       String?
  roleApplied String
  stage       String   @default("New")
  source      String   @default("Manual")
  meetUrl     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([roleApplied])
  @@index([stage])
}

model EmployeeMeeting {
  id             Int      @id @default(autoincrement())
  title          String
  startsAt       DateTime
  endsAt         DateTime
  meetUrl        String?
  audienceRoles  String   @default("all")
  applicantName  String?
  applicantEmail String?
  notes          String?
  createdBy      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([startsAt])
  @@index([audienceRoles])
}

model EmployeeResource {
  id            Int      @id @default(autoincrement())
  title         String
  resourceType  String   @default("Link")
  url           String
  description   String?
  audienceRoles String   @default("all")
  tags          String?
  createdBy     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([resourceType])
  @@index([audienceRoles])
  @@index([createdAt])
}
